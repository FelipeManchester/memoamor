# ─────────────────────────────────────────────
# MEMOAMOR — Variáveis de Ambiente
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Apenas no servidor — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── AbacatePay ────────────────────────────────
ABACATEPAY_API_KEY=sua_api_key_aqui
ABACATEPAY_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ── Resend ────────────────────────────────────
RESEND_API_KEY=re_sua_api_key_aqui
RESEND_FROM_EMAIL=oi@memoamor.app

# ── YouTube ───────────────────────────────────
# Opcional — para buscar título/thumbnail da música
NEXT_PUBLIC_YOUTUBE_API_KEY=sua_youtube_api_key_aqui
